# MemTranslator configuration example
#
# Normal installations should run `memtranslator init`; it writes the active
# configuration to the application data directory. This file documents the
# supported environment contract for source development and deployments.
# Never commit real API keys.

MT_PORT=8123

# LLM connection
MT_LLM_API_FORMAT=openai-compatible
MT_TRANSLATOR=deepseek-v4-flash
MT_WRITER=deepseek-v4-flash
MT_DOWNSTREAM=deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=

# Local embedding is the default. `memtranslator init` downloads the model
# and writes the machine-specific MT_EMBED_MODEL_DIR value.
MT_EMBEDDING_MODE=local

# Remote embedding alternative. Uncomment all fields below; the key and base
# URL may stay empty to reuse the active LLM connection, provided that endpoint
# exposes an OpenAI-compatible /embeddings API.
# MT_EMBEDDING_MODE=remote
# MT_EMBEDDING_MODEL=your-embedding-model
# MT_EMBEDDING_BASE_URL=
# MT_EMBEDDING_API_KEY=
